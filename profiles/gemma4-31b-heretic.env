# Gemma-4-31B uncensored (heretic) -- the single-model candidate: native
# tools plus the top uncensored writing score in its class. BF16 weights are
# ~63GB, so vLLM quantizes to FP8 on load (~32GB) to leave room for context.
POD_NAME=analyst
ENGINE=vllm
MODEL_REPO=llmfan46/gemma-4-31B-it-uncensored-heretic
TOOL_PARSER=gemma4
CTX=32768
EXTRA_ARGS="--reasoning-parser gemma4 --quantization fp8 --gpu-memory-utilization 0.92"
